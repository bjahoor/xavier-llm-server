[Unit]
Description=llama-server — NVIDIA Nemotron-Elastic-12B-A2B, 8 slots, 256K context per slot
Documentation=https://huggingface.co/mradermacher/NVIDIA-Nemotron-Labs-3-Elastic-12B-A2B-i1-GGUF

# wait for storage and GPU power gating (CUDA needs nvpmodel)
After=mnt-microsd.mount nvpmodel.service
Requires=mnt-microsd.mount nvpmodel.service

# fail loudly if model or binary missing
AssertPathExists=/mnt/microsd/models/NVIDIA-Nemotron-Labs-3-Elastic-12B-A2B.i1-Q5_K_M.gguf
AssertFileIsExecutable=/home/user/llama.cpp/build/bin/llama-server

[Service]
User=user
Restart=no

Environment=GGML_CUDA_ENABLE_UNIFIED_MEMORY=1
Environment=PARALLEL_SLOTS=8
Environment=CONTEXT_PER_SLOT=262144
Environment=MODEL=NVIDIA-Nemotron-Labs-3-Elastic-12B-A2B.i1-Q5_K_M.gguf
Environment=MODEL_DIR=/mnt/microsd/models

# free lingering RAM before load
ExecStartPre=+/bin/sh -c "sync && echo 3 > /proc/sys/vm/drop_caches"

# start the model server
ExecStart=/bin/sh -c 'exec "$HOME"/llama.cpp/build/bin/llama-server \
  -m $MODEL_DIR/$MODEL \
  -fa on \
  -ctk q8_0 -ctv q8_0 \
  --jinja \
  -dio \
  -fit off \
  -c $((CONTEXT_PER_SLOT * PARALLEL_SLOTS)) -np $PARALLEL_SLOTS \
  -b 4096 -ub 2048 \
  -ctxcp 1 \
  --cache-ram 0 \
  --host 0.0.0.0 \
  --port 8080'

# allow 10 min to load model before failing
TimeoutStartSec=600

[Install]
# start automatically on boot
WantedBy=default.target
